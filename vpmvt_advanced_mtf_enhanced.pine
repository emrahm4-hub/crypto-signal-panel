//@version=5
indicator("VPMVT Advanced MTF Enhanced System", overlay=false, max_labels_count=500, max_lines_count=500)

// ════════════════════════════════════════════════════════════════════
// 🆕 YENİ ÖZELLİKLER
// ════════════════════════════════════════════════════════════════════
// ✅ Özelleştirilebilir Timeframe'ler (13 TF)
// ✅ Reset Mekanizması (Totalleri sıfırlama)
// ✅ MTF Confluence Zone Detector
// ✅ MTF Trend Alignment Score
// ✅ Dynamic Timeframe Auto-Selector
// ✅ Repainting FIX (barmerge parametreleri)
// ✅ Overflow Protection
// ✅ Performance Optimization
// ✅ MTF Strength Visualization
// ════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════════
// İNPUTS - TRADING MODE
// ════════════════════════════════════════════════════════════════════
trading_mode = input.string("Day Trader", "Trading Mode", options=["Scalper", "Day Trader", "Swing Trader"], group="Trading Style")

// ════════════════════════════════════════════════════════════════════
// 🆕 CUSTOMIZABLE TIMEFRAMES
// ════════════════════════════════════════════════════════════════════
use_custom_tf = input.bool(false, "Use Custom Timeframes", group="⏱️ Timeframes")
enable_auto_tf = input.bool(true, "Auto-Select TF Based on Chart", group="⏱️ Timeframes", tooltip="Otomatik olarak chart TF'ye göre uygun timeframe'leri seçer")

tf1  = input.timeframe("10S", "TF 1 (Ultra Fast)", group="⏱️ Timeframes")
tf2  = input.timeframe("1",   "TF 2 (Very Fast)", group="⏱️ Timeframes")
tf3  = input.timeframe("5",   "TF 3 (Fast)", group="⏱️ Timeframes")
tf4  = input.timeframe("15",  "TF 4", group="⏱️ Timeframes")
tf5  = input.timeframe("30",  "TF 5", group="⏱️ Timeframes")
tf6  = input.timeframe("60",  "TF 6 (1H)", group="⏱️ Timeframes")
tf7  = input.timeframe("120", "TF 7 (2H)", group="⏱️ Timeframes")
tf8  = input.timeframe("240", "TF 8 (4H)", group="⏱️ Timeframes")
tf9  = input.timeframe("480", "TF 9 (8H)", group="⏱️ Timeframes")
tf10 = input.timeframe("720", "TF 10 (12H)", group="⏱️ Timeframes")
tf11 = input.timeframe("D",   "TF 11 (Daily)", group="⏱️ Timeframes")
tf12 = input.timeframe("3D",  "TF 12 (3D)", group="⏱️ Timeframes")
tf13 = input.timeframe("W",   "TF 13 (Weekly)", group="⏱️ Timeframes")

// ════════════════════════════════════════════════════════════════════
// 🆕 RESET MECHANISM
// ════════════════════════════════════════════════════════════════════
reset_on_new_day = input.bool(false, "Reset Totals on New Day", group="🔄 Reset Controls")
reset_on_new_week = input.bool(false, "Reset Totals on New Week", group="🔄 Reset Controls")
reset_on_new_month = input.bool(false, "Reset Totals on New Month", group="🔄 Reset Controls")
manual_reset = input.bool(false, "Manual Reset NOW", group="🔄 Reset Controls", tooltip="Bu seçeneği aktif edip kaydederseniz tüm totaller sıfırlanır")

// Reset condition
is_new_day = ta.change(dayofmonth) != 0
is_new_week = ta.change(weekofyear) != 0
is_new_month = ta.change(month) != 0

should_reset = manual_reset or
               (reset_on_new_day and is_new_day) or
               (reset_on_new_week and is_new_week) or
               (reset_on_new_month and is_new_month)

// ════════════════════════════════════════════════════════════════════
// DISPLAY SETTINGS
// ════════════════════════════════════════════════════════════════════
show_breakout_table = input.bool(true, "Show Breakout Detection Table", group="📊 Display")
show_htf_ratio = input.bool(true, "Show HTF Ratio", group="📊 Display")
show_composite = input.bool(true, "Show Composite Score", group="📊 Display")
show_total_amounts = input.bool(true, "Show All-Time Totals", group="📊 Display")
show_market_comment = input.bool(true, "Show Market Comment", group="📊 Display")
show_recent_movement = input.bool(true, "Show Recent Movement", group="📊 Display")
show_breakout_potential = input.bool(true, "Show Breakout Potential", group="📊 Display")
show_mtf_confluence = input.bool(true, "🆕 Show MTF Confluence Zone", group="📊 Display")
show_mtf_alignment = input.bool(true, "🆕 Show MTF Trend Alignment", group="📊 Display")
show_mtf_strength = input.bool(true, "🆕 Show MTF Strength Score", group="📊 Display")

// ════════════════════════════════════════════════════════════════════
// SETTINGS
// ════════════════════════════════════════════════════════════════════
hh_ll_length = input.int(50, "HH/LL Detection Length", minval=5, maxval=200, group="⚙️ Settings")
htf_threshold = input.float(60.0, "HTF Bullish Threshold", minval=50, maxval=100, group="⚙️ Settings")
confluence_threshold = input.int(7, "🆕 MTF Confluence Threshold", minval=3, maxval=13, group="⚙️ Settings", tooltip="Kaç TF aynı yönde olmalı")

// Recent Movement lookback
recent_lookback = trading_mode == "Scalper" ? 5 : trading_mode == "Day Trader" ? 20 : 50

// ════════════════════════════════════════════════════════════════════
// 🆕 DYNAMIC TIMEFRAME AUTO-SELECTOR
// ════════════════════════════════════════════════════════════════════
f_get_higher_tf(_current_tf) =>
    result = _current_tf == "1"  ? "5"   :
             _current_tf == "5"  ? "15"  :
             _current_tf == "15" ? "60"  :
             _current_tf == "30" ? "60"  :
             _current_tf == "60" ? "240" :
             _current_tf == "240"? "D"   :
             _current_tf == "D"  ? "W"   : "W"
    result

current_chart_tf = timeframe.period
auto_htf = f_get_higher_tf(current_chart_tf)

// Use auto TF if enabled
final_tf1  = enable_auto_tf and not use_custom_tf ? (timeframe.isintraday ? "1" : "D")    : tf1
final_tf2  = enable_auto_tf and not use_custom_tf ? (timeframe.isintraday ? "5" : "D")    : tf2
final_tf3  = enable_auto_tf and not use_custom_tf ? (timeframe.isintraday ? "15" : "W")   : tf3
final_tf4  = enable_auto_tf and not use_custom_tf ? (timeframe.isintraday ? "30" : "W")   : tf4
final_tf5  = enable_auto_tf and not use_custom_tf ? (timeframe.isintraday ? "60" : "M")   : tf5
final_tf6  = enable_auto_tf and not use_custom_tf ? "60"  : tf6
final_tf7  = enable_auto_tf and not use_custom_tf ? "120" : tf7
final_tf8  = enable_auto_tf and not use_custom_tf ? "240" : tf8
final_tf9  = enable_auto_tf and not use_custom_tf ? "480" : tf9
final_tf10 = enable_auto_tf and not use_custom_tf ? "720" : tf10
final_tf11 = enable_auto_tf and not use_custom_tf ? "D"   : tf11
final_tf12 = enable_auto_tf and not use_custom_tf ? "3D"  : tf12
final_tf13 = enable_auto_tf and not use_custom_tf ? "W"   : tf13

// ════════════════════════════════════════════════════════════════════
// TRACKING VARIABLES (Function dışında tanımlanmalı!)
// ════════════════════════════════════════════════════════════════════
var int prev_bullish_count = 0
var int prev_bearish_count = 0
var float prev_net_power_bp = 0.0

// ════════════════════════════════════════════════════════════════════
// NET POWER HESAPLAMA FONKSİYONU (OVERFLOW PROTECTED)
// ════════════════════════════════════════════════════════════════════
f_calculate_net_power(_src, _vol, _high, _low, _close_prev, _should_reset) =>
    // 🆕 Overflow protection: Max değer limiti
    MAX_VALUE = 1e15

    // 1. Price Change
    deltaX = ta.change(_src)
    var float posX = 0.0
    var float negX = 0.0

    // 🆕 Reset check
    if _should_reset
        posX := 0.0
        negX := 0.0

    posX := deltaX > 0 ? math.min(nz(posX[1]) + deltaX, MAX_VALUE) : nz(posX[1])
    negX := deltaX < 0 ? math.min(nz(negX[1]) + math.abs(deltaX), MAX_VALUE) : nz(negX[1])
    totalX = posX + negX
    posXPercent = totalX > 0 ? posX / totalX * 100 : 0
    negXPercent = totalX > 0 ? negX / totalX * 100 : 0

    // 2. Momentum
    price_vol_momentum = deltaX * _vol
    var float posMom = 0.0
    var float negMom = 0.0

    if _should_reset
        posMom := 0.0
        negMom := 0.0

    posMom := price_vol_momentum > 0 ? math.min(nz(posMom[1]) + price_vol_momentum, MAX_VALUE) : nz(posMom[1])
    negMom := price_vol_momentum < 0 ? math.min(nz(negMom[1]) + math.abs(price_vol_momentum), MAX_VALUE) : nz(negMom[1])
    totalMom = posMom + negMom
    posMomPercent = totalMom > 0 ? posMom / totalMom * 100 : 0
    negMomPercent = totalMom > 0 ? negMom / totalMom * 100 : 0

    // 3. Acceleration
    roc_value = ta.roc(_src, 14)
    var float posAcc = 0.0
    var float negAcc = 0.0

    if _should_reset
        posAcc := 0.0
        negAcc := 0.0

    posAcc := roc_value > 0 ? math.min(nz(posAcc[1]) + roc_value, MAX_VALUE) : nz(posAcc[1])
    negAcc := roc_value < 0 ? math.min(nz(negAcc[1]) + math.abs(roc_value), MAX_VALUE) : nz(negAcc[1])
    totalAcc = posAcc + negAcc
    posAccPercent = totalAcc > 0 ? posAcc / totalAcc * 100 : 0
    negAccPercent = totalAcc > 0 ? negAcc / totalAcc * 100 : 0

    // 4. Volume Pressure
    volume_pressure = deltaX > 0 ? _vol : deltaX < 0 ? -_vol : 0
    var float posVP = 0.0
    var float negVP = 0.0

    if _should_reset
        posVP := 0.0
        negVP := 0.0

    posVP := volume_pressure > 0 ? math.min(nz(posVP[1]) + volume_pressure, MAX_VALUE) : nz(posVP[1])
    negVP := volume_pressure < 0 ? math.min(nz(negVP[1]) + math.abs(volume_pressure), MAX_VALUE) : nz(negVP[1])
    totalVP = posVP + negVP
    posVPPercent = totalVP > 0 ? posVP / totalVP * 100 : 0
    negVPPercent = totalVP > 0 ? negVP / totalVP * 100 : 0

    // 5. Volatility
    tr = math.max(_high - _low, math.max(math.abs(_high - _close_prev), math.abs(_low - _close_prev)))
    volatility_up = _src > _close_prev ? tr : 0
    volatility_down = _src < _close_prev ? tr : 0
    var float cum_vol_up = 0.0
    var float cum_vol_down = 0.0

    if _should_reset
        cum_vol_up := 0.0
        cum_vol_down := 0.0

    cum_vol_up := math.min(nz(cum_vol_up[1]) + volatility_up, MAX_VALUE)
    cum_vol_down := math.min(nz(cum_vol_down[1]) + volatility_down, MAX_VALUE)
    total_vol = cum_vol_up + cum_vol_down
    vol_up_pct = total_vol > 0 ? cum_vol_up / total_vol * 100 : 0
    vol_down_pct = total_vol > 0 ? cum_vol_down / total_vol * 100 : 0

    // 6. Time Analysis
    range_tf = _high - _low
    momentum_tf = ta.change(_src)
    var float pos_time = 0.0
    var float neg_time = 0.0

    if _should_reset
        pos_time := 0.0
        neg_time := 0.0

    pos_time := momentum_tf > 0 ? math.min(nz(pos_time[1]) + range_tf, MAX_VALUE) : nz(pos_time[1])
    neg_time := momentum_tf < 0 ? math.min(nz(neg_time[1]) + range_tf, MAX_VALUE) : nz(neg_time[1])
    total_time = pos_time + neg_time
    time_pct = total_time > 0 ? pos_time / total_time * 100 : 50

    // Unified Composite
    total_pos = posXPercent + posMomPercent + posAccPercent + posVPPercent + vol_up_pct + time_pct
    total_neg = negXPercent + negMomPercent + negAccPercent + negVPPercent + vol_down_pct + (100 - time_pct)
    grand_total = total_pos + total_neg
    bullish_pct = grand_total > 0 ? total_pos / grand_total * 100 : 50
    net_power = bullish_pct - (100 - bullish_pct)

    // All-time totals
    [net_power, bullish_pct, posX + posMom + posAcc, negX + negMom + negAcc, totalVP]

// ════════════════════════════════════════════════════════════════════
// HH/LL TESPİT FONKSİYONU
// ════════════════════════════════════════════════════════════════════
f_detect_hh_ll(_high, _low, _close, _length) =>
    hh = ta.highest(_high, _length)
    ll = ta.lowest(_low, _length)
    hh_break = _close > hh[1]
    ll_break = _close < ll[1]
    [hh, ll, hh_break, ll_break]

// ════════════════════════════════════════════════════════════════════
// BREAKOUT POTENTIAL DETECTOR
// ════════════════════════════════════════════════════════════════════
f_breakout_potential(_lookback, _htf_bull, _htf_bear, _net_power) =>
    // 1. VOLUME TREND
    current_vol = volume
    avg_vol_short = ta.sma(volume, 10)
    avg_vol_long = ta.sma(volume, 50)
    vol_ratio = avg_vol_short / avg_vol_long
    vol_score = vol_ratio > 2.0 ? 30 : vol_ratio > 1.5 ? 25 : vol_ratio > 1.2 ? 15 : vol_ratio > 1.0 ? 5 : 0
    vol_trend = vol_ratio > 1.5 ? "RISING ⬆️" : vol_ratio > 1.0 ? "Normal 📊" : "LOW 📉"

    // 2. PRICE COMPRESSION
    atr_current = ta.atr(14)
    atr_long = ta.sma(ta.atr(14), 50)
    compression_ratio = atr_current / atr_long
    compression_bars = 0
    for i = 0 to 19
        if ta.atr(14)[i] < atr_long
            compression_bars += 1
    compression_score = compression_ratio < 0.5 ? 25 : compression_ratio < 0.7 ? 20 : compression_ratio < 0.85 ? 10 : 0
    compression_status = compression_ratio < 0.6 ? "TIGHT! 🔥" : compression_ratio < 0.8 ? "Narrowing 📉" : "Normal 📊"

    // 3. HTF ALIGNMENT
    alignment_score = _htf_bull >= 6 ? 25 : _htf_bull >= 4 ? 15 : _htf_bear >= 6 ? 25 : _htf_bear >= 4 ? 15 : 0
    alignment_status = _htf_bull > prev_bullish_count ? "BULLISH BUILDING 📈" :
                      _htf_bear > prev_bearish_count ? "BEARISH BUILDING 📉" : "Stable ➡️"

    // 4. NET POWER MOMENTUM
    net_power_change = _net_power - nz(prev_net_power_bp)
    net_power_momentum_score = math.abs(net_power_change) > 10 ? 20 : math.abs(net_power_change) > 5 ? 15 : math.abs(net_power_change) > 2 ? 10 : 0
    net_power_status = net_power_change > 5 ? "RISING ⬆️" : net_power_change < -5 ? "FALLING ⬇️" : "Stable ➡️"

    // 5. TOTAL SCORE
    total_score = vol_score + compression_score + alignment_score + net_power_momentum_score

    // 6. BREAKOUT DIRECTION & PROBABILITY
    breakout_direction = ""
    breakout_probability = 0.0

    if _htf_bull >= 5 and _net_power > 0
        breakout_direction := "UP 🚀"
        breakout_probability := math.min(50 + (_htf_bull * 5) + (_net_power / 2), 95)
    else if _htf_bear >= 5 and _net_power < 0
        breakout_direction := "DOWN 💥"
        breakout_probability := math.min(50 + (_htf_bear * 5) + (math.abs(_net_power) / 2), 95)
    else if _net_power > 10
        breakout_direction := "UP 🚀"
        breakout_probability := 60 + _net_power
    else if _net_power < -10
        breakout_direction := "DOWN 💥"
        breakout_probability := 60 + math.abs(_net_power)
    else
        breakout_direction := "UNCLEAR ⚖️"
        breakout_probability := 50

    // 7. STRENGTH
    breakout_strength = total_score > 80 ? "VERY HIGH 🔥" :
                       total_score > 60 ? "HIGH 💥" :
                       total_score > 40 ? "MEDIUM ⚡" : "LOW 📊"

    // 8. EXPECTED TIMEFRAME
    expected_bars = compression_bars > 15 ? "1-5 bars" : compression_bars > 10 ? "3-10 bars" : compression_bars > 5 ? "5-15 bars" : "10-20 bars"

    // 9. TARGETS
    current_price = close
    atr_for_target = ta.atr(14)
    target_1 = breakout_direction == "UP 🚀" ? current_price + (atr_for_target * 1.5) :
               breakout_direction == "DOWN 💥" ? current_price - (atr_for_target * 1.5) : current_price
    target_2 = breakout_direction == "UP 🚀" ? current_price + (atr_for_target * 3.0) :
               breakout_direction == "DOWN 💥" ? current_price - (atr_for_target * 3.0) : current_price

    // 10. STOP LEVEL
    invalidation = breakout_direction == "UP 🚀" ? current_price - (atr_for_target * 1.0) :
                   breakout_direction == "DOWN 💥" ? current_price + (atr_for_target * 1.0) : current_price

    [total_score, vol_trend, vol_ratio, compression_status, compression_bars, alignment_status,
     net_power_status, breakout_direction, breakout_probability, breakout_strength, expected_bars,
     target_1, target_2, invalidation]

// ════════════════════════════════════════════════════════════════════
// RECENT MOVEMENT ANALİZİ
// ════════════════════════════════════════════════════════════════════
f_recent_movement(_lookback) =>
    price_start = close[_lookback]
    price_now = close
    price_change = ((price_now - price_start) / price_start) * 100

    avg_volume = ta.sma(volume, _lookback)
    current_volume = volume
    volume_ratio = current_volume / avg_volume
    volume_strength = volume_ratio > 1.5 ? "HIGH 💥" : volume_ratio > 1.0 ? "NORMAL 📊" : "LOW 📉"

    recent_momentum = ta.sma(close, 5) - ta.sma(close[5], 5)
    momentum_direction = recent_momentum > 0 ? "UP ⬆️" : recent_momentum < 0 ? "DOWN ⬇️" : "FLAT ➡️"
    momentum_strength = math.abs(recent_momentum) > (ta.atr(14) * 0.5) ? "STRONG" : "WEAK"

    trend_direction = price_change > 2 ? "STRONG UP 🚀" :
                     price_change > 0 ? "UP 📈" :
                     price_change < -2 ? "STRONG DOWN 💥" :
                     price_change < 0 ? "DOWN 📉" : "FLAT ➡️"

    signal = ""
    signal_color = color.gray

    if price_change > 2 and volume_ratio > 1.2
        signal := "LONG SETUP! 🟢"
        signal_color := #00C853
    else if price_change > 0 and volume_ratio > 1.0
        signal := "Weak Long 📈"
        signal_color := #4CAF50
    else if price_change < -2 and volume_ratio > 1.2
        signal := "SHORT SETUP! 🔴"
        signal_color := #F44336
    else if price_change < 0 and volume_ratio > 1.0
        signal := "Weak Short 📉"
        signal_color := #FF5252
    else
        signal := "Wait ⚖️"
        signal_color := #FF9800

    [price_change, volume_strength, volume_ratio, momentum_direction, momentum_strength, trend_direction, signal, signal_color]

// ════════════════════════════════════════════════════════════════════
// 🆕 MTF CONFLUENCE ZONE DETECTOR
// ════════════════════════════════════════════════════════════════════
f_mtf_confluence(_bull_array, _threshold) =>
    bullish_count = 0
    bearish_count = 0

    for i = 0 to array.size(_bull_array) - 1
        bull_val = array.get(_bull_array, i)
        if bull_val >= 60
            bullish_count += 1
        else if bull_val <= 40
            bearish_count += 1

    is_confluence = bullish_count >= _threshold or bearish_count >= _threshold
    confluence_type = bullish_count >= _threshold ? "BULLISH" : bearish_count >= _threshold ? "BEARISH" : "MIXED"
    confluence_strength = math.max(bullish_count, bearish_count)

    [is_confluence, confluence_type, confluence_strength, bullish_count, bearish_count]

// ════════════════════════════════════════════════════════════════════
// 🆕 MTF TREND ALIGNMENT SCORE
// ════════════════════════════════════════════════════════════════════
f_mtf_alignment(_net_array) =>
    positive_count = 0
    negative_count = 0
    strong_positive = 0
    strong_negative = 0

    for i = 0 to array.size(_net_array) - 1
        net_val = array.get(_net_array, i)
        if net_val > 10
            strong_positive += 1
            positive_count += 1
        else if net_val > 0
            positive_count += 1
        else if net_val < -10
            strong_negative += 1
            negative_count += 1
        else if net_val < 0
            negative_count += 1

    total_tf = array.size(_net_array)
    alignment_score = positive_count >= negative_count ?
                     (positive_count / total_tf * 100) :
                     (negative_count / total_tf * 100)

    alignment_direction = positive_count > negative_count ? "BULLISH" :
                         negative_count > positive_count ? "BEARISH" : "NEUTRAL"

    alignment_quality = strong_positive >= 8 ? "VERY STRONG BULL 🔥" :
                       strong_positive >= 5 ? "STRONG BULL 💪" :
                       strong_negative >= 8 ? "VERY STRONG BEAR ❄️" :
                       strong_negative >= 5 ? "STRONG BEAR 💥" : "WEAK/MIXED ⚖️"

    [alignment_score, alignment_direction, alignment_quality, strong_positive, strong_negative]

// ════════════════════════════════════════════════════════════════════
// CURRENT TF NET POWER
// ════════════════════════════════════════════════════════════════════
[net_power_current, bullish_current, pos_total_current, neg_total_current, vp_total_current] =
     f_calculate_net_power(close, volume, high, low, close[1], should_reset)

// Main plot
plot(net_power_current,
     color = net_power_current > 0 ? color.new(#00E676, 0) : color.new(#FF5252, 0),
     title="NET POWER",
     linewidth=4)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dashed)

// ════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME ANALYSIS (13 TF) - 🆕 REPAINTING FIX
// ════════════════════════════════════════════════════════════════════

// TF 1
[close_tf1, high_tf1, low_tf1, vol_tf1] = request.security(syminfo.tickerid, final_tf1, [close, high, low, volume], barmerge.gaps_off, barmerge.lookahead_off)
close_prev_tf1 = request.security(syminfo.tickerid, final_tf1, close[1], barmerge.gaps_off, barmerge.lookahead_off)
[net_tf1, bull_tf1, pos_tf1, neg_tf1, vp_tf1] = f_calculate_net_power(close_tf1, vol_tf1, high_tf1, low_tf1, close_prev_tf1, should_reset)
[hh_tf1, ll_tf1, hh_break_tf1, ll_break_tf1] = f_detect_hh_ll(high_tf1, low_tf1, close_tf1, hh_ll_length)

// TF 2
[close_tf2, high_tf2, low_tf2, vol_tf2] = request.security(syminfo.tickerid, final_tf2, [close, high, low, volume], barmerge.gaps_off, barmerge.lookahead_off)
close_prev_tf2 = request.security(syminfo.tickerid, final_tf2, close[1], barmerge.gaps_off, barmerge.lookahead_off)
[net_tf2, bull_tf2, pos_tf2, neg_tf2, vp_tf2] = f_calculate_net_power(close_tf2, vol_tf2, high_tf2, low_tf2, close_prev_tf2, should_reset)
[hh_tf2, ll_tf2, hh_break_tf2, ll_break_tf2] = f_detect_hh_ll(high_tf2, low_tf2, close_tf2, hh_ll_length)

// TF 3
[close_tf3, high_tf3, low_tf3, vol_tf3] = request.security(syminfo.tickerid, final_tf3, [close, high, low, volume], barmerge.gaps_off, barmerge.lookahead_off)
close_prev_tf3 = request.security(syminfo.tickerid, final_tf3, close[1], barmerge.gaps_off, barmerge.lookahead_off)
