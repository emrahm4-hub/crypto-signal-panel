[net_tf13, bull_tf13, pos_tf13, neg_tf13, vp_tf13] = f_calculate_net_power(close_tf13, vol_tf13, high_tf13, low_tf13, close_prev_tf13, should_reset)
[hh_tf13, ll_tf13, hh_break_tf13, ll_break_tf13] = f_detect_hh_ll(high_tf13, low_tf13, close_tf13, hh_ll_length)

// ════════════════════════════════════════════════════════════════════
// 🆕 MTF CONFLUENCE & ALIGNMENT ANALYSIS
// ════════════════════════════════════════════════════════════════════
var bull_array = array.new_float(13)
array.set(bull_array, 0, bull_tf1)
array.set(bull_array, 1, bull_tf2)
array.set(bull_array, 2, bull_tf3)
array.set(bull_array, 3, bull_tf4)
array.set(bull_array, 4, bull_tf5)
array.set(bull_array, 5, bull_tf6)
array.set(bull_array, 6, bull_tf7)
array.set(bull_array, 7, bull_tf8)
array.set(bull_array, 8, bull_tf9)
array.set(bull_array, 9, bull_tf10)
array.set(bull_array, 10, bull_tf11)
array.set(bull_array, 11, bull_tf12)
array.set(bull_array, 12, bull_tf13)

var net_array = array.new_float(13)
array.set(net_array, 0, net_tf1)
array.set(net_array, 1, net_tf2)
array.set(net_array, 2, net_tf3)
array.set(net_array, 3, net_tf4)
array.set(net_array, 4, net_tf5)
array.set(net_array, 5, net_tf6)
array.set(net_array, 6, net_tf7)
array.set(net_array, 7, net_tf8)
array.set(net_array, 8, net_tf9)
array.set(net_array, 9, net_tf10)
array.set(net_array, 10, net_tf11)
array.set(net_array, 11, net_tf12)
array.set(net_array, 12, net_tf13)

[is_confluence, confluence_type, confluence_strength, conf_bull_count, conf_bear_count] =
     f_mtf_confluence(bull_array, confluence_threshold)

[alignment_score, alignment_direction, alignment_quality, strong_bull_count, strong_bear_count] =
     f_mtf_alignment(net_array)

// ════════════════════════════════════════════════════════════════════
// HTF RATIO CALCULATION
// ════════════════════════════════════════════════════════════════════
htf_bullish_count = 0
htf_bearish_count = 0

// HTF = 1h and above (tf6 onwards)
if bull_tf6 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf6 < (100 - htf_threshold)
    htf_bearish_count += 1

if bull_tf7 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf7 < (100 - htf_threshold)
    htf_bearish_count += 1

if bull_tf8 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf8 < (100 - htf_threshold)
    htf_bearish_count += 1

if bull_tf9 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf9 < (100 - htf_threshold)
    htf_bearish_count += 1

if bull_tf10 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf10 < (100 - htf_threshold)
    htf_bearish_count += 1

if bull_tf11 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf11 < (100 - htf_threshold)
    htf_bearish_count += 1

if bull_tf12 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf12 < (100 - htf_threshold)
    htf_bearish_count += 1

if bull_tf13 >= htf_threshold
    htf_bullish_count += 1
else if bull_tf13 < (100 - htf_threshold)
    htf_bearish_count += 1

htf_total = htf_bullish_count + htf_bearish_count
htf_bullish_ratio = htf_total > 0 ? htf_bullish_count / htf_total * 100 : 50

// ════════════════════════════════════════════════════════════════════
// COMPOSITE SCORE
// ════════════════════════════════════════════════════════════════════
composite_score = (bull_tf1 * 0.5 + bull_tf2 * 0.7 + bull_tf3 * 1.0 + bull_tf4 * 1.2 +
                   bull_tf5 * 1.5 + bull_tf6 * 2.0 + bull_tf7 * 2.5 + bull_tf8 * 3.0 +
                   bull_tf9 * 3.5 + bull_tf10 * 4.0 + bull_tf11 * 5.0 + bull_tf12 * 6.0 + bull_tf13 * 7.0) /
                  (0.5 + 0.7 + 1.0 + 1.2 + 1.5 + 2.0 + 2.5 + 3.0 + 3.5 + 4.0 + 5.0 + 6.0 + 7.0)

composite_net_power = composite_score - (100 - composite_score)

// ════════════════════════════════════════════════════════════════════
// ALL-TIME TOTALS
// ════════════════════════════════════════════════════════════════════
all_time_positive = pos_tf1 + pos_tf2 + pos_tf3 + pos_tf4 + pos_tf5 + pos_tf6 + pos_tf7 + pos_tf8 + pos_tf9 + pos_tf10 + pos_tf11 + pos_tf12 + pos_tf13
all_time_negative = neg_tf1 + neg_tf2 + neg_tf3 + neg_tf4 + neg_tf5 + neg_tf6 + neg_tf7 + neg_tf8 + neg_tf9 + neg_tf10 + neg_tf11 + neg_tf12 + neg_tf13
all_time_volume_pressure = vp_tf1 + vp_tf2 + vp_tf3 + vp_tf4 + vp_tf5 + vp_tf6 + vp_tf7 + vp_tf8 + vp_tf9 + vp_tf10 + vp_tf11 + vp_tf12 + vp_tf13
all_time_net = all_time_positive - all_time_negative

var float prev_net_total = 0.0
net_change = all_time_net - nz(prev_net_total)
prev_net_total := all_time_net

net_trend = net_change > 0 ? "RISING ⬆️" : net_change < 0 ? "FALLING ⬇️" : "STABLE ➡️"
buying_power = all_time_net > 0 and net_change > 0 ? "BUY POWER UP 🚀" :
               all_time_net > 0 and net_change < 0 ? "BUY POWER WEAK ⚠️" :
               all_time_net < 0 and net_change < 0 ? "SELL PRESSURE UP 💥" :
               all_time_net < 0 and net_change > 0 ? "SELL PRESSURE DOWN 📈" : "BALANCED ⚖️"

pos_simplified = all_time_positive / 1000000000
neg_simplified = all_time_negative / 1000000000
net_simplified = all_time_net / 1000000000
vp_simplified = all_time_volume_pressure / 1000000000

// ════════════════════════════════════════════════════════════════════
// RECENT MOVEMENT
// ════════════════════════════════════════════════════════════════════
[recent_change, recent_vol_str, recent_vol_ratio, recent_momentum_dir, recent_momentum_str, recent_trend, recent_signal, recent_signal_color] =
     f_recent_movement(recent_lookback)

// ════════════════════════════════════════════════════════════════════
// BREAKOUT POTENTIAL
// ════════════════════════════════════════════════════════════════════
[bp_score, bp_vol_trend, bp_vol_ratio, bp_compression, bp_comp_bars, bp_alignment,
 bp_net_power, bp_direction, bp_probability, bp_strength, bp_time, bp_target1, bp_target2, bp_stop] =
     f_breakout_potential(20, htf_bullish_count, htf_bearish_count, net_power_current)

// Update tracking variables
prev_bullish_count := htf_bullish_count
prev_bearish_count := htf_bearish_count
prev_net_power_bp := net_power_current

bp_is_bullish = str.contains(bp_direction, "UP")
bp_is_bearish = str.contains(bp_direction, "DOWN")

// ════════════════════════════════════════════════════════════════════
// MARKET ANALYSIS
// ════════════════════════════════════════════════════════════════════
general_trend = all_time_net > 0 ? "BULLISH" : all_time_net < 0 ? "BEARISH" : "NEUTRAL"
htf_status = htf_bullish_ratio >= 60 ? "HTF Bullish" : htf_bullish_ratio <= 40 ? "HTF Bearish" : "HTF Mixed"

market_condition = ""
if general_trend == "BULLISH" and htf_bullish_ratio >= 60
    market_condition := "🚀 STRONG UPTREND"
else if general_trend == "BULLISH" and htf_bullish_ratio < 60
    market_condition := "⚠️ PULLBACK (Uptrend)"
else if general_trend == "BEARISH" and htf_bullish_ratio <= 40
    market_condition := "💥 STRONG DOWNTREND"
else if general_trend == "BEARISH" and htf_bullish_ratio > 40
    market_condition := "📈 RECOVERY (Downtrend)"
else
    market_condition := "⚖️ RANGING MARKET"

trade_suggestion = ""
if htf_bullish_ratio >= 70 and composite_score >= 60
    trade_suggestion := "LONG position favorable"
else if htf_bullish_ratio <= 30 and composite_score <= 40
    trade_suggestion := "SHORT position favorable"
else if htf_bullish_ratio >= 60 and composite_score < 50
    trade_suggestion := "HTF bullish but weak momentum - careful LONG"
else if htf_bullish_ratio <= 40 and composite_score > 50
    trade_suggestion := "HTF bearish but momentum up - conflict"
else
    trade_suggestion := "Wait for clear signal"

// ════════════════════════════════════════════════════════════════════
// BREAKOUT DETECTION
// ════════════════════════════════════════════════════════════════════
breakout_tf = ""
breakout_type = ""

if hh_break_tf13
    breakout_tf := final_tf13
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf13
    breakout_tf := final_tf13
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf12
    breakout_tf := final_tf12
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf12
    breakout_tf := final_tf12
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf11
    breakout_tf := final_tf11
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf11
    breakout_tf := final_tf11
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf10
    breakout_tf := final_tf10
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf10
    breakout_tf := final_tf10
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf9
    breakout_tf := final_tf9
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf9
    breakout_tf := final_tf9
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf8
    breakout_tf := final_tf8
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf8
    breakout_tf := final_tf8
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf7
    breakout_tf := final_tf7
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf7
    breakout_tf := final_tf7
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf6
    breakout_tf := final_tf6
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf6
    breakout_tf := final_tf6
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf5
    breakout_tf := final_tf5
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf5
    breakout_tf := final_tf5
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf4
    breakout_tf := final_tf4
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf4
    breakout_tf := final_tf4
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf3
    breakout_tf := final_tf3
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf3
    breakout_tf := final_tf3
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf2
    breakout_tf := final_tf2
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf2
    breakout_tf := final_tf2
    breakout_type := "LL BREAK ⬇️"
else if hh_break_tf1
    breakout_tf := final_tf1
    breakout_type := "HH BREAK ⬆️"
else if ll_break_tf1
    breakout_tf := final_tf1
    breakout_type := "LL BREAK ⬇️"
else
    breakout_tf := "NONE"
    breakout_type := "NO BREAK"

// ════════════════════════════════════════════════════════════════════
// VISUAL SIGNALS
// ════════════════════════════════════════════════════════════════════

// Recent Movement Signals
recent_bg_color = show_recent_movement and recent_change > 3 and recent_vol_ratio > 1.5 ? color.new(#00C853, 90) :
                  show_recent_movement and recent_change < -3 and recent_vol_ratio > 1.5 ? color.new(#F44336, 90) : na
bgcolor(recent_bg_color, title="Recent Movement BG")

plotshape(show_recent_movement and recent_change > 3 and recent_vol_ratio > 1.5,
          style=shape.triangleup, location=location.bottom, color=#00C853, size=size.small,
          title="Long Setup", text="LONG")

plotshape(show_recent_movement and recent_change < -3 and recent_vol_ratio > 1.5,
          style=shape.triangledown, location=location.top, color=#F44336, size=size.small,
          title="Short Setup", text="SHORT")

// Breakout Potential Signals
plotshape(show_breakout_potential and bp_score > 75 and bp_is_bullish,
          style=shape.diamond, location=location.belowbar, color=#FF6B00, size=size.normal,
          title="Breakout Potential UP", text="BP⬆")

plotshape(show_breakout_potential and bp_score > 75 and bp_is_bearish,
          style=shape.diamond, location=location.abovebar, color=#FF6B00, size=size.normal,
          title="Breakout Potential DOWN", text="BP⬇")

bp_bg_color = show_breakout_potential and bp_score > 80 ? color.new(#FF6B00, 95) : na
bgcolor(bp_bg_color, title="High Breakout Potential BG")

// 🆕 MTF Confluence Signals
// MTF Confluence boolean flags
is_bullish_confluence = is_confluence and conf_bull_count > conf_bear_count
is_bearish_confluence = is_confluence and conf_bear_count > conf_bull_count

plotshape(show_mtf_confluence and is_bullish_confluence,
          style=shape.circle, location=location.bottom, color=#00E676, size=size.large,
          title="MTF Bullish Confluence", text="CF🟢")

plotshape(show_mtf_confluence and is_bearish_confluence,
          style=shape.circle, location=location.top, color=#FF1744, size=size.large,
          title="MTF Bearish Confluence", text="CF🔴")

conf_bg_color = show_mtf_confluence and is_bullish_confluence ? color.new(#00E676, 92) :
                show_mtf_confluence and is_bearish_confluence ? color.new(#FF1744, 92) : na
bgcolor(conf_bg_color, title="MTF Confluence BG")

// ════════════════════════════════════════════════════════════════════
// TABLE 1 - LEFT SIDE (TIMEFRAMES)
// ════════════════════════════════════════════════════════════════════
var table tf_table = table.new(position.middle_left, 6, 20, border_width=2, frame_color=#1E88E5, frame_width=2)

if barstate.islast
    table.clear(tf_table, 0, 0, 5, 19)

    // Header
    table.cell(tf_table, 0, 0, "⏱️ TIMEFRAMES",
               bgcolor=#0D47A1, text_color=color.white, text_size=size.normal)
    table.merge_cells(tf_table, 0, 0, 5, 0)

    row = 1

    // Column Headers
    table.cell(tf_table, 0, row, "TF", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(tf_table, 1, row, "NET", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(tf_table, 2, row, "BULL%", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(tf_table, 3, row, "SIG", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(tf_table, 4, row, "HH", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    table.cell(tf_table, 5, row, "LL", bgcolor=#37474F, text_color=color.white, text_size=size.small)
    row += 1

    // Data
    var string[] tf_labels = array.from(final_tf1, final_tf2, final_tf3, final_tf4, final_tf5, final_tf6,
                                        final_tf7, final_tf8, final_tf9, final_tf10, final_tf11, final_tf12, final_tf13)
    var float[]  tf_nets   = array.from(net_tf1, net_tf2, net_tf3, net_tf4, net_tf5, net_tf6,
                                        net_tf7, net_tf8, net_tf9, net_tf10, net_tf11, net_tf12, net_tf13)
    var float[]  tf_bulls  = array.from(bull_tf1, bull_tf2, bull_tf3, bull_tf4, bull_tf5, bull_tf6,
                                        bull_tf7, bull_tf8, bull_tf9, bull_tf10, bull_tf11, bull_tf12, bull_tf13)
    var bool[]   tf_hh     = array.from(hh_break_tf1, hh_break_tf2, hh_break_tf3, hh_break_tf4, hh_break_tf5, hh_break_tf6,
                                        hh_break_tf7, hh_break_tf8, hh_break_tf9, hh_break_tf10, hh_break_tf11, hh_break_tf12, hh_break_tf13)
    var bool[]   tf_ll     = array.from(ll_break_tf1, ll_break_tf2, ll_break_tf3, ll_break_tf4, ll_break_tf5, ll_break_tf6,
                                        ll_break_tf7, ll_break_tf8, ll_break_tf9, ll_break_tf10, ll_break_tf11, ll_break_tf12, ll_break_tf13)

    for i = 0 to 12
        tf_label = array.get(tf_labels, i)
        tf_net   = array.get(tf_nets, i)
        tf_bull  = array.get(tf_bulls, i)
        tf_hh_break = array.get(tf_hh, i)
        tf_ll_break = array.get(tf_ll, i)

        net_col = tf_net > 0 ? #00C853 : #F44336
        bull_col = tf_bull >= 60 ? #00C853 : tf_bull <= 40 ? #F44336 : #FF9800
        signal_txt = tf_bull >= 70 ? "🚀" : tf_bull >= 60 ? "📈" : tf_bull <= 30 ? "💥" : tf_bull <= 40 ? "📉" : "⚖️"

        table.cell(tf_table, 0, row, tf_label, bgcolor=#455A64, text_color=color.white, text_size=size.small)
        table.cell(tf_table, 1, row, str.tostring(tf_net, "#.#"), bgcolor=net_col, text_color=color.white, text_size=size.small)
        table.cell(tf_table, 2, row, str.tostring(tf_bull, "#"), bgcolor=bull_col, text_color=color.white, text_size=size.small)
        table.cell(tf_table, 3, row, signal_txt, bgcolor=#455A64, text_color=color.white, text_size=size.small)
        table.cell(tf_table, 4, row, tf_hh_break ? "✅" : "⬜", bgcolor=tf_hh_break ? #00C853 : #37474F, text_color=color.white, text_size=size.small)
        table.cell(tf_table, 5, row, tf_ll_break ? "✅" : "⬜", bgcolor=tf_ll_break ? #F44336 : #37474F, text_color=color.white, text_size=size.small)

        row += 1

// ════════════════════════════════════════════════════════════════════
// TABLE 2 - RIGHT SIDE (ANALYSIS)
// ════════════════════════════════════════════════════════════════════
var table main_table = table.new(position.middle_right, 6, 60, border_width=2, frame_color=#1E88E5, frame_width=2)

if barstate.islast
    table.clear(main_table, 0, 0, 5, 59)

    // Header
    table.cell(main_table, 0, 0, "🎯 VPMVT MTF ENHANCED",
               bgcolor=#0D47A1, text_color=color.white, text_size=size.normal)
    table.merge_cells(main_table, 0, 0, 5, 0)

    row = 1

    // 1. BREAKOUT DETECTION
    if show_breakout_table
        table.cell(main_table, 0, row, "📊 BREAKOUT",
                   bgcolor=#1565C0, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        breakout_color = breakout_type == "HH BREAK ⬆️" ? #00C853 : breakout_type == "LL BREAK ⬇️" ? #F44336 : #757575
        table.cell(main_table, 0, row, "TF:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, breakout_tf, bgcolor=breakout_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 2, row, breakout_type, bgcolor=breakout_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 2, row, 5, row)
        row += 1

    // 2. 🆕 MTF CONFLUENCE
    if show_mtf_confluence
        table.cell(main_table, 0, row, "🆕 MTF CONFLUENCE",
                   bgcolor=#7C4DFF, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        conf_color = is_bullish_confluence ? #00E676 : is_bearish_confluence ? #FF1744 : #FF9800
        conf_status = is_confluence ? "ACTIVE ✅" : "NONE ⬜"
        conf_text = is_bullish_confluence ? "BULLISH" : is_bearish_confluence ? "BEARISH" : "MIXED"

        table.cell(main_table, 0, row, conf_status, bgcolor=conf_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, conf_text, bgcolor=conf_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 2, row, str.tostring(confluence_strength) + "/13", bgcolor=conf_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 2, row, 5, row)
        row += 1

    // 3. 🆕 MTF TREND ALIGNMENT
    if show_mtf_alignment
        table.cell(main_table, 0, row, "🆕 MTF ALIGNMENT",
                   bgcolor=#7C4DFF, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        is_align_bullish = strong_bull_count > strong_bear_count
        is_align_bearish = strong_bear_count > strong_bull_count
        align_color = is_align_bullish ? #00C853 : is_align_bearish ? #F44336 : #FF9800
        align_text = is_align_bullish ? "BULLISH" : is_align_bearish ? "BEARISH" : "NEUTRAL"

        table.cell(main_table, 0, row, str.tostring(alignment_score, "#.#") + "%",
                   bgcolor=align_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, align_text, bgcolor=align_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 1, row, 5, row)
        row += 1

        table.cell(main_table, 0, row, alignment_quality, bgcolor=align_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

    // 4. HTF RATIO
    if show_htf_ratio
        table.cell(main_table, 0, row, "📈 HTF RATIO",
                   bgcolor=#1565C0, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        htf_color = htf_bullish_ratio >= 60 ? #00C853 : htf_bullish_ratio <= 40 ? #F44336 : #FF9800
        table.cell(main_table, 0, row, "Bull:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, str.tostring(htf_bullish_count), bgcolor=#00C853, text_color=color.white, text_size=size.small)
        table.cell(main_table, 2, row, "Bear:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
        table.cell(main_table, 3, row, str.tostring(htf_bearish_count), bgcolor=#F44336, text_color=color.white, text_size=size.small)
        row += 1

        htf_signal = htf_bullish_ratio >= 70 ? "STRONG BULL 🚀" :
                     htf_bullish_ratio >= 60 ? "BULLISH 📈" :
                     htf_bullish_ratio <= 30 ? "STRONG BEAR 💥" :
                     htf_bullish_ratio <= 40 ? "BEARISH 📉" : "NEUTRAL ⚖️"

        table.cell(main_table, 0, row, str.tostring(htf_bullish_ratio, "#.#") + "%",
                   bgcolor=htf_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, htf_signal, bgcolor=htf_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 1, row, 5, row)
        row += 1

    // 5. COMPOSITE
    if show_composite
        table.cell(main_table, 0, row, "🎯 COMPOSITE",
                   bgcolor=#1565C0, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        comp_color = composite_score >= 60 ? #00C853 : composite_score <= 40 ? #F44336 : #FF9800
        comp_signal = composite_score >= 70 ? "VERY STRONG 🔥" :
                      composite_score >= 60 ? "STRONG 💪" :
                      composite_score <= 30 ? "VERY WEAK ❄️" :
                      composite_score <= 40 ? "WEAK 😔" : "BALANCED ⚖️"

        table.cell(main_table, 0, row, str.tostring(composite_score, "#.#") + "%",
                   bgcolor=comp_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, comp_signal, bgcolor=comp_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 1, row, 5, row)
        row += 1

    // 6. RECENT MOVEMENT
    if show_recent_movement
        mode_text = trading_mode == "Scalper" ? "⚡ SCALPER" : trading_mode == "Day Trader" ? "📊 DAY" : "📈 SWING"

        table.cell(main_table, 0, row, mode_text + " (" + str.tostring(recent_lookback) + ")",
                   bgcolor=#7C4DFF, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        change_color = recent_change > 0 ? #00C853 : #F44336
        table.cell(main_table, 0, row, str.tostring(recent_change, "#.#") + "%",
                   bgcolor=change_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, recent_trend, bgcolor=change_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 1, row, 5, row)
        row += 1

        table.cell(main_table, 0, row, recent_signal,
                   bgcolor=recent_signal_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

    // 7. BREAKOUT POTENTIAL
    if show_breakout_potential
        score_color = bp_score > 75 ? #FF6B00 : bp_score > 60 ? #FFA726 : bp_score > 40 ? #FFB74D : #757575

        table.cell(main_table, 0, row, "🔥 BREAKOUT POT.",
                   bgcolor=#FF6B00, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        table.cell(main_table, 0, row, str.tostring(bp_score, "#") + "/100",
                   bgcolor=score_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, bp_strength, bgcolor=score_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 1, row, 5, row)
        row += 1

        direction_color = bp_is_bullish ? #00C853 : bp_is_bearish ? #F44336 : #FF9800
        table.cell(main_table, 0, row, bp_direction,
                   bgcolor=direction_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, str.tostring(bp_probability, "#.#") + "%",
                   bgcolor=direction_color, text_color=color.white, text_size=size.small)
        table.cell(main_table, 2, row, bp_time, bgcolor=#455A64, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 2, row, 5, row)
        row += 1

        if bp_is_bullish or bp_is_bearish
            table.cell(main_table, 0, row, "T1:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
            table.cell(main_table, 1, row, str.tostring(bp_target1, "#.####"),
                       bgcolor=direction_color, text_color=color.white, text_size=size.small)
            table.merge_cells(main_table, 1, row, 2, row)

            table.cell(main_table, 3, row, "T2:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
            table.cell(main_table, 4, row, str.tostring(bp_target2, "#.####"),
                       bgcolor=direction_color, text_color=color.white, text_size=size.small)
            table.merge_cells(main_table, 4, row, 5, row)
            row += 1

    // 8. ALL-TIME TOTALS
    if show_total_amounts
        table.cell(main_table, 0, row, "💰 ALL-TIME",
                   bgcolor=#1565C0, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        table.cell(main_table, 0, row, "Pos:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, str.tostring(pos_simplified, "#,##0.0") + "B",
                   bgcolor=#00C853, text_color=color.white, text_size=size.small)
        table.cell(main_table, 2, row, "Neg:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
        table.cell(main_table, 3, row, str.tostring(neg_simplified, "#,##0.0") + "B",
                   bgcolor=#F44336, text_color=color.white, text_size=size.small)
        row += 1

        net_color = all_time_net > 0 ? #00C853 : #F44336
        table.cell(main_table, 0, row, "Net:", bgcolor=#37474F, text_color=color.white, text_size=size.small)
        table.cell(main_table, 1, row, str.tostring(net_simplified, "#,##0.0") + "B",
                   bgcolor=net_color, text_color=color.white, text_size=size.small)

        trend_color = net_change > 0 ? #00C853 : net_change < 0 ? #F44336 : #FF9800
        table.cell(main_table, 2, row, net_trend,
                   bgcolor=trend_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 2, row, 5, row)
        row += 1

    // 9. MARKET COMMENT
    if show_market_comment
        table.cell(main_table, 0, row, "📝 MARKET",
                   bgcolor=#1565C0, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        condition_color = str.pos(market_condition, "STRONG UPTREND") >= 0 ? #00C853 :
                         str.pos(market_condition, "STRONG DOWNTREND") >= 0 ? #F44336 :
                         str.pos(market_condition, "PULLBACK") >= 0 or str.pos(market_condition, "RECOVERY") >= 0 ? #FF9800 : #757575
        table.cell(main_table, 0, row, market_condition,
                   bgcolor=condition_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

        suggestion_color = str.pos(trade_suggestion, "LONG position") >= 0 ? #00C853 :
                          str.pos(trade_suggestion, "SHORT position") >= 0 ? #F44336 :
                          str.pos(trade_suggestion, "Wait") >= 0 ? #757575 : #FF9800
        table.cell(main_table, 0, row, trade_suggestion,
                   bgcolor=suggestion_color, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

    // 10. 🆕 RESET INFO
    if should_reset
        table.cell(main_table, 0, row, "🔄 RESET ACTIVE!",
                   bgcolor=#FF1744, text_color=color.white, text_size=size.small)
        table.merge_cells(main_table, 0, row, 5, row)
        row += 1

// ════════════════════════════════════════════════════════════════════
// ALERTS
// ════════════════════════════════════════════════════════════════════

// HTF Breakouts
alertcondition(hh_break_tf11 or hh_break_tf13 or hh_break_tf12,
               title="HTF HH Break",
               message="Higher Timeframe HH Break")

alertcondition(ll_break_tf11 or ll_break_tf13 or ll_break_tf12,
               title="HTF LL Break",
               message="Higher Timeframe LL Break")

// HTF Ratio
alertcondition(htf_bullish_ratio >= 75,
               title="Strong HTF Bullish",
               message="HTF Ratio: Strong Bullish")

alertcondition(htf_bullish_ratio <= 25,
               title="Strong HTF Bearish",
               message="HTF Ratio: Strong Bearish")

// Composite
alertcondition(composite_score >= 75,
               title="Composite Very Strong",
               message="Composite: Very Strong")

alertcondition(composite_score <= 25,
               title="Composite Very Weak",
               message="Composite: Very Weak")

// Recent Movement
alertcondition(recent_change > 3 and recent_vol_ratio > 1.5,
               title="Strong Long Setup",
               message="Recent: Strong LONG Setup!")

alertcondition(recent_change < -3 and recent_vol_ratio > 1.5,
               title="Strong Short Setup",
               message="Recent: Strong SHORT Setup!")

// Breakout Potential
alertcondition(bp_score > 80,
               title="Very High Breakout Potential",
               message="Breakout Potential: Very High!")

alertcondition(bp_score > 75 and bp_is_bullish,
               title="Bullish Breakout Building",
               message="Bullish Breakout Building!")

alertcondition(bp_score > 75 and bp_is_bearish,
               title="Bearish Breakout Building",
               message="Bearish Breakout Building!")

// 🆕 MTF Confluence Alerts
alertcondition(is_bullish_confluence,
               title="MTF Bullish Confluence",
               message="MTF Bullish Confluence Detected!")

alertcondition(is_bearish_confluence,
               title="MTF Bearish Confluence",
               message="MTF Bearish Confluence Detected!")

// 🆕 MTF Alignment Alerts
alertcondition(strong_bull_count >= 8,
               title="Very Strong MTF Bull Alignment",
               message="Very Strong Bullish MTF Alignment!")

alertcondition(strong_bear_count >= 8,
               title="Very Strong MTF Bear Alignment",
               message="Very Strong Bearish MTF Alignment!")
